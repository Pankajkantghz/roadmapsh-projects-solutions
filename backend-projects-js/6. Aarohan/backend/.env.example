NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/aarohan

# Generate independent random values (for example: openssl rand -hex 32).
ACCESS_TOKEN_SECRET=replace-with-a-long-random-access-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-refresh-secret
REFRESH_TOKEN_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins.
ALLOWED_ORIGINS=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Set this email to give its first registered account the admin role.
ADMIN_EMAIL=admin@example.com

# Gmail SMTP app password (needed for signup verification and password recovery).
EMAIL_USER=
EMAIL_PASS=

# Optional; needed only for image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
