```gitignore
# Dependencies
node_modules/

# Environment variables
.env

# Build output
dist/
build/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# IDE / Editor settings
.vscode/
.idea/

# TypeScript cache
*.tsbuildinfo

# npm/yarn lock logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage reports
coverage/

# Temporary files
.tmp/
.temp/

# Docker
docker-data/
```
